              }
            ]
          },
          "docs": "Get user's portfolio"
        },
        {
          "info": {
            "name": "Get user trades.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-testnet.gte.xyz/v1/users/:user_address/trades",
            "params": [
              {
                "name": "user_address",
                "value": "",
                "type": "path"
              },
              {
                "name": "market_address",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Gets user trades on GTE. Returns all trades from all markets if `market_address` is empty."
        },
