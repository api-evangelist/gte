      "items": [
        {
          "info": {
            "name": "Get LP positions for a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-testnet.gte.xyz/v1/users/:user_address/lppositions",
            "params": [
              {
                "name": "user_address",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get LP positions for a user"
        },
        {
          "info": {
            "name": "Get user's portfolio",
            "type": "http"
          },
          "http": {
            "method": "GET",
